      "config": {
        "title": "Recent",
        "attributes": {
          "type": "datatable",
          "dataset": {
            "type": "esql",
            "query": "FROM logs-azure.spring_apps* | KEEP `@timestamp`, `azure.spring_apps.app_name`, operationName, resultType, event.duration, event.outcome, correlationId | SORT `@timestamp` DESC | LIMIT 100"
          },
          "metrics": [
            {
              "operation": "value",
              "column": "`@timestamp`",
              "label": "Time"
            },
            {
              "operation": "value",
              "column": "azure.spring_apps.app_name",
              "label": "App"
