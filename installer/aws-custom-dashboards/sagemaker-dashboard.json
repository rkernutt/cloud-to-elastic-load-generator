{
  "title": "Amazon SageMaker \u2014 Endpoints & Training",
  "time_range": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "lens",
      "uid": "sm-kpi-invocations",
      "grid": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "config": {
        "title": "",
        "attributes": {
          "type": "metric",
          "dataset": {
            "type": "esql",
            "query": "FROM metrics-aws_sagemaker.metrics* | STATS `Total Invocations` = SUM(`aws_sagemaker.metrics.invocations`)"
          },
          "metrics": [
            {
              "type": "primary",
              "operation": "value",
              "column": "Total Invocations"
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sm-kpi-latency",
      "grid": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "config": {
        "title": "",
        "attributes": {
          "type": "metric",
          "dataset": {
            "type": "esql",
            "query": "FROM metrics-aws_sagemaker.metrics* | STATS `Avg Model Latency (µs)` = AVG(`aws_sagemaker.metrics.model_latency`)"
          },
          "metrics": [
            {
              "type": "primary",
              "operation": "value",
              "column": "Avg Model Latency (µs)"
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sm-kpi-4xx",
      "grid": {
        "x": 24,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "config": {
        "title": "",
        "attributes": {
          "type": "metric",
          "dataset": {
            "type": "esql",
            "query": "FROM metrics-aws_sagemaker.metrics* | STATS `Total 4xx Errors` = SUM(`aws_sagemaker.metrics.invocation_4xx_errors`)"
          },
          "metrics": [
            {
              "type": "primary",
              "operation": "value",
              "column": "Total 4xx Errors"
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sm-kpi-5xx",
      "grid": {
        "x": 36,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "config": {
        "title": "",
        "attributes": {
          "type": "metric",
          "dataset": {
            "type": "esql",
            "query": "FROM metrics-aws_sagemaker.metrics* | STATS `Total 5xx Errors` = SUM(`aws_sagemaker.metrics.invocation_5xx_errors`)"
          },
          "metrics": [
            {
              "type": "primary",
              "operation": "value",
              "column": "Total 5xx Errors"
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sm-invocations",
      "grid": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 10
      },
      "config": {
        "title": "Invocations Over Time",
        "attributes": {
          "type": "xy",
          "axis": {
            "x": {
              "title": {
                "visible": false
              }
            },
            "left": {
              "title": {
                "visible": false
              }
            }
          },
          "layers": [
            {
              "type": "area",
              "dataset": {
                "type": "esql",
                "query": "FROM metrics-aws_sagemaker.metrics* | STATS invocations = SUM(`aws_sagemaker.metrics.invocations`) BY bucket = BUCKET(`@timestamp`, 75, ?_tstart, ?_tend) | SORT bucket"
              },
              "x": {
                "operation": "value",
                "column": "bucket"
              },
              "y": [
                {
                  "operation": "value",
                  "column": "invocations",
                  "label": "Invocations"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sm-latency",
      "grid": {
        "x": 24,
        "y": 5,
        "w": 24,
        "h": 10
      },
      "config": {
        "title": "Model Latency (µs)",
        "attributes": {
          "type": "xy",
          "axis": {
            "x": {
              "title": {
                "visible": false
              }
            },
            "left": {
              "title": {
                "visible": false
              }
            }
          },
          "layers": [
            {
              "type": "line",
              "dataset": {
                "type": "esql",
                "query": "FROM metrics-aws_sagemaker.metrics* | STATS avg_latency = AVG(`aws_sagemaker.metrics.model_latency`) BY bucket = BUCKET(`@timestamp`, 75, ?_tstart, ?_tend) | SORT bucket"
              },
              "x": {
                "operation": "value",
                "column": "bucket"
              },
              "y": [
                {
                  "operation": "value",
                  "column": "avg_latency",
                  "label": "Latency (ms)"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sm-errors",
      "grid": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 10
      },
      "config": {
        "title": "4xx / 5xx Errors Over Time",
        "attributes": {
          "type": "xy",
          "axis": {
            "x": {
              "title": {
                "visible": false
              }
            },
            "left": {
              "title": {
                "visible": false
              }
            }
          },
          "layers": [
            {
              "type": "line",
              "dataset": {
                "type": "esql",
                "query": "FROM metrics-aws_sagemaker.metrics* | STATS errors_4xx = SUM(`aws_sagemaker.metrics.invocation_4xx_errors`), errors_5xx = SUM(`aws_sagemaker.metrics.invocation_5xx_errors`) BY bucket = BUCKET(`@timestamp`, 75, ?_tstart, ?_tend) | SORT bucket"
              },
              "x": {
                "operation": "value",
                "column": "bucket"
              },
              "y": [
                {
                  "operation": "value",
                  "column": "errors_4xx",
                  "label": "4xx Errors"
                },
                {
                  "operation": "value",
                  "column": "errors_5xx",
                  "label": "5xx Errors"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sm-utilization",
      "grid": {
        "x": 24,
        "y": 15,
        "w": 24,
        "h": 10
      },
      "config": {
        "title": "GPU / CPU Utilization (%)",
        "attributes": {
          "type": "xy",
          "axis": {
            "x": {
              "title": {
                "visible": false
              }
            },
            "left": {
              "title": {
                "visible": false
              }
            }
          },
          "layers": [
            {
              "type": "line",
              "dataset": {
                "type": "esql",
                "query": "FROM metrics-aws_sagemaker.metrics* | STATS gpu = AVG(`aws_sagemaker.metrics.gpu_utilization`), cpu = AVG(`aws_sagemaker.metrics.cpu_utilization`) BY bucket = BUCKET(`@timestamp`, 75, ?_tstart, ?_tend) | SORT bucket"
              },
              "x": {
                "operation": "value",
                "column": "bucket"
              },
              "y": [
                {
                  "operation": "value",
                  "column": "gpu",
                  "label": "GPU %"
                },
                {
                  "operation": "value",
                  "column": "cpu",
                  "label": "CPU %"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sm-outcomes",
      "grid": {
        "x": 0,
        "y": 25,
        "w": 16,
        "h": 10
      },
      "config": {
        "title": "Job Outcomes",
        "attributes": {
          "type": "donut",
          "dataset": {
            "type": "esql",
            "query": "FROM logs-aws_sagemaker.logs* | STATS count = COUNT() BY outcome = log.level"
          },
          "metrics": [
            {
              "operation": "value",
              "column": "count"
            }
          ],
          "group_by": [
            {
              "operation": "value",
              "column": "outcome"
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sm-job-type",
      "grid": {
        "x": 16,
        "y": 25,
        "w": 32,
        "h": 10
      },
      "config": {
        "title": "Events by Workload",
        "attributes": {
          "type": "xy",
          "axis": {
            "x": {
              "title": {
                "visible": false
              }
            },
            "left": {
              "title": {
                "visible": false
              }
            }
          },
          "layers": [
            {
              "type": "bar_horizontal",
              "dataset": {
                "type": "esql",
                "query": "FROM logs-aws_sagemaker.logs* | STATS count = COUNT() BY workload = `aws_sagemaker.workload` | SORT count DESC"
              },
              "x": {
                "operation": "value",
                "column": "workload"
              },
              "y": [
                {
                  "operation": "value",
                  "column": "count",
                  "label": "Events"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sm-event-action",
      "grid": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 10
      },
      "config": {
        "title": "Events by Log Group",
        "attributes": {
          "type": "xy",
          "axis": {
            "x": {
              "title": {
                "visible": false
              }
            },
            "left": {
              "title": {
                "visible": false
              }
            }
          },
          "layers": [
            {
              "type": "bar_horizontal",
              "dataset": {
                "type": "esql",
                "query": "FROM logs-aws_sagemaker.logs* | STATS count = COUNT() BY log_group = `log.logger` | SORT count DESC | LIMIT 10"
              },
              "x": {
                "operation": "value",
                "column": "log_group"
              },
              "y": [
                {
                  "operation": "value",
                  "column": "count",
                  "label": "Events"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sm-log-table",
      "grid": {
        "x": 0,
        "y": 45,
        "w": 48,
        "h": 12
      },
      "config": {
        "title": "Recent SageMaker Events",
        "attributes": {
          "type": "datatable",
          "dataset": {
            "type": "esql",
            "query": "FROM logs-aws_sagemaker.logs* | KEEP `@timestamp`, `aws_sagemaker.workload`, `aws_sagemaker.job.name`, `aws_sagemaker.endpoint.name`, log.level, message | SORT `@timestamp` DESC | LIMIT 100"
          },
          "metrics": [
            {
              "operation": "value",
              "column": "`@timestamp`",
              "label": "Timestamp"
            },
            {
              "operation": "value",
              "column": "aws_sagemaker.workload",
              "label": "Workload"
            },
            {
              "operation": "value",
              "column": "aws_sagemaker.job.name",
              "label": "Job Name"
            },
            {
              "operation": "value",
              "column": "aws_sagemaker.endpoint.name",
              "label": "Endpoint"
            },
            {
              "operation": "value",
              "column": "log.level",
              "label": "Log level"
            },
            {
              "operation": "value",
              "column": "message",
              "label": "Message"
            }
          ],
          "rows": []
        }
      }
    }
  ]
}
