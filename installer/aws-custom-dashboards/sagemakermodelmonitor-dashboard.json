{
  "title": "Amazon SageMaker — Endpoint Errors",
  "time_range": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "lens",
      "uid": "sagemakermodelmonitor-kpi-total-events",
      "grid": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "config": {
        "title": "",
        "attributes": {
          "type": "metric",
          "dataset": {
            "type": "esql",
            "query": "FROM metrics-aws_sagemaker.metrics* | WHERE `aws_sagemaker.metrics.namespace` == \"AWS/SageMaker\" | STATS `5xx Errors` = SUM(`aws_sagemaker.metrics.invocation_5xx_errors`)"
          },
          "metrics": [
            {
              "type": "primary",
              "operation": "value",
              "column": "5xx Errors"
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sagemakermodelmonitor-kpi-errors",
      "grid": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "config": {
        "title": "",
        "attributes": {
          "type": "metric",
          "dataset": {
            "type": "esql",
            "query": "FROM metrics-aws_sagemaker.metrics* | WHERE `aws_sagemaker.metrics.namespace` == \"AWS/SageMaker\" | STATS `4xx Errors` = SUM(`aws_sagemaker.metrics.invocation_4xx_errors`)"
          },
          "metrics": [
            {
              "type": "primary",
              "operation": "value",
              "column": "4xx Errors"
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sagemakermodelmonitor-kpi-unique-resources",
      "grid": {
        "x": 24,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "config": {
        "title": "",
        "attributes": {
          "type": "metric",
          "dataset": {
            "type": "esql",
            "query": "FROM metrics-aws_sagemaker.metrics* | WHERE `aws_sagemaker.metrics.namespace` == \"AWS/SageMaker\" | STATS `Unique Endpoints` = COUNT_DISTINCT(`aws_sagemaker.endpoint.name`)"
          },
          "metrics": [
            {
              "type": "primary",
              "operation": "value",
              "column": "Unique Endpoints"
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sagemakermodelmonitor-kpi-violations",
      "grid": {
        "x": 36,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "config": {
        "title": "",
        "attributes": {
          "type": "metric",
          "dataset": {
            "type": "esql",
            "query": "FROM metrics-aws_sagemaker.metrics* | WHERE `aws_sagemaker.metrics.namespace` == \"AWS/SageMaker\" | STATS `Model Errors` = SUM(`aws_sagemaker.metrics.invocation_model_errors`)"
          },
          "metrics": [
            {
              "type": "primary",
              "operation": "value",
              "column": "Model Errors"
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sagemakermodelmonitor-donut-outcome",
      "grid": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 10
      },
      "config": {
        "title": "Endpoint Log Levels",
        "attributes": {
          "type": "donut",
          "dataset": {
            "type": "esql",
            "query": "FROM logs-aws_sagemaker.logs* | WHERE `aws_sagemaker.workload` == \"endpoint\" | STATS count = COUNT() BY outcome = log.level | SORT count DESC | LIMIT 10"
          },
          "dimensions": [
            {
              "column": "outcome",
              "type": "category"
            }
          ],
          "metrics": [
            {
              "type": "size",
              "operation": "value",
              "column": "count"
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sagemakermodelmonitor-bar-timeline",
      "grid": {
        "x": 0,
        "y": 15,
        "w": 48,
        "h": 12
      },
      "config": {
        "title": "Events Over Time",
        "attributes": {
          "type": "bar_stacked",
          "dataset": {
            "type": "esql",
            "query": "FROM logs-aws_sagemaker.logs* | WHERE `aws_sagemaker.workload` == \"endpoint\" | EVAL bucket = DATE_TRUNC(15 minutes, `@timestamp`) | STATS count = COUNT() BY bucket, outcome = log.level | SORT bucket"
          },
          "xAxis": {
            "column": "bucket",
            "type": "date"
          },
          "breakdown": {
            "column": "outcome",
            "type": "category"
          },
          "metrics": [
            {
              "type": "bar",
              "operation": "value",
              "column": "count"
            }
          ]
        }
      }
    }
  ]
}
