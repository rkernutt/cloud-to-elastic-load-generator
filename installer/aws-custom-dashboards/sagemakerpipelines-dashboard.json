{
  "title": "Amazon SageMaker Pipelines — ML Pipeline Execution",
  "time_range": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "lens",
      "uid": "sagemakerpipelines-kpi-total-events",
      "grid": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "config": {
        "title": "",
        "attributes": {
          "type": "metric",
          "dataset": {
            "type": "esql",
            "query": "FROM metrics-aws_sagemaker.metrics* | WHERE `aws_sagemaker.metrics.namespace` == \"AWS/Sagemaker/ModelBuildingPipeline\" | STATS `Executions` = SUM(`aws_sagemaker.metrics.execution_started`) + SUM(`aws_sagemaker.metrics.execution_failed`)"
          },
          "metrics": [
            {
              "type": "primary",
              "operation": "value",
              "column": "Executions"
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sagemakerpipelines-kpi-errors",
      "grid": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "config": {
        "title": "",
        "attributes": {
          "type": "metric",
          "dataset": {
            "type": "esql",
            "query": "FROM metrics-aws_sagemaker.metrics* | WHERE `aws_sagemaker.metrics.namespace` == \"AWS/Sagemaker/ModelBuildingPipeline\" | STATS `Failed Executions` = SUM(`aws_sagemaker.metrics.execution_failed`)"
          },
          "metrics": [
            {
              "type": "primary",
              "operation": "value",
              "column": "Failed Executions"
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sagemakerpipelines-kpi-unique-resources",
      "grid": {
        "x": 24,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "config": {
        "title": "",
        "attributes": {
          "type": "metric",
          "dataset": {
            "type": "esql",
            "query": "FROM metrics-aws_sagemaker.metrics* | WHERE `aws_sagemaker.metrics.namespace` == \"AWS/Sagemaker/ModelBuildingPipeline\" | STATS `Unique Pipelines` = COUNT_DISTINCT(`aws_sagemaker.pipeline.name`)"
          },
          "metrics": [
            {
              "type": "primary",
              "operation": "value",
              "column": "Unique Pipelines"
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sagemakerpipelines-donut-outcome",
      "grid": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 10
      },
      "config": {
        "title": "Execution Outcome",
        "attributes": {
          "type": "donut",
          "dataset": {
            "type": "esql",
            "query": "FROM metrics-aws_sagemaker.metrics* | WHERE `aws_sagemaker.metrics.namespace` == \"AWS/Sagemaker/ModelBuildingPipeline\" | EVAL outcome = CASE(`aws_sagemaker.metrics.execution_failed` > 0, \"failed\", \"succeeded\") | STATS count = COUNT() BY outcome"
          },
          "dimensions": [
            {
              "column": "outcome",
              "type": "category"
            }
          ],
          "metrics": [
            {
              "type": "size",
              "operation": "value",
              "column": "count"
            }
          ]
        }
      }
    },
    {
      "type": "lens",
      "uid": "sagemakerpipelines-bar-timeline",
      "grid": {
        "x": 0,
        "y": 15,
        "w": 48,
        "h": 12
      },
      "config": {
        "title": "Pipeline Executions Over Time",
        "attributes": {
          "type": "bar_stacked",
          "dataset": {
            "type": "esql",
            "query": "FROM metrics-aws_sagemaker.metrics* | WHERE `aws_sagemaker.metrics.namespace` == \"AWS/Sagemaker/ModelBuildingPipeline\" | EVAL bucket = DATE_TRUNC(15 minutes, `@timestamp`), outcome = CASE(`aws_sagemaker.metrics.execution_failed` > 0, \"failed\", \"succeeded\") | STATS count = COUNT() BY bucket, outcome | SORT bucket"
          },
          "xAxis": {
            "column": "bucket",
            "type": "date"
          },
          "breakdown": {
            "column": "outcome",
            "type": "category"
          },
          "metrics": [
            {
              "type": "bar",
              "operation": "value",
              "column": "count"
            }
          ]
        }
      }
    }
  ]
}
