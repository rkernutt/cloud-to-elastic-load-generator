metricsets: ["cloudwatch"] period:
{{period}}
{{#if data_granularity}}
  data_granularity:
  {{data_granularity}}
{{/if}}
{{#if regions}}
  regions:
  {{#each regions as |region|}}
    -
    {{region}}
  {{/each}}
{{/if}}
{{#if latency}}
  latency:
  {{latency}}
{{/if}}
{{#if include_linked_accounts}}
  include_linked_accounts:
  {{include_linked_accounts}}
{{/if}}
{{#if owning_account}}
  owning_account:
  {{owning_account}}
{{/if}}
{{#if tags_filter}}
  tags_filter:
  {{tags_filter}}
{{/if}}
metrics: - namespace: AWS/SageMaker statistic: ["Sum"] name: - Invocations - Invocation4XXErrors -
Invocation5XXErrors - InvocationModelErrors - namespace: AWS/SageMaker statistic: ["Average"] name:
- ModelLatency - OverheadLatency - namespace: /aws/sagemaker/Endpoints statistic: ["Average"] name:
- CPUUtilization - MemoryUtilization - GPUUtilization - GPUMemoryUtilization - DiskUtilization -
namespace: /aws/sagemaker/TrainingJobs statistic: ["Average"] name: - CPUUtilization -
MemoryUtilization - GPUUtilization - GPUMemoryUtilization - DiskUtilization - namespace:
/aws/sagemaker/ProcessingJobs statistic: ["Average"] name: - CPUUtilization - MemoryUtilization -
GPUUtilization - GPUMemoryUtilization - DiskUtilization - namespace: /aws/sagemaker/TransformJobs
statistic: ["Average"] name: - CPUUtilization - MemoryUtilization - GPUUtilization -
GPUMemoryUtilization - namespace: /aws/sagemaker/InferenceComponents statistic: ["Average"] name: -
CPUUtilizationNormalized - MemoryUtilizationNormalized - GPUUtilizationNormalized -
GPUMemoryUtilizationNormalized - DiskUtilizationNormalized - namespace:
AWS/Sagemaker/ModelBuildingPipeline statistic: ["Sum"] name: - ExecutionStarted - ExecutionFailed -
ExecutionSucceeded - StepFailed - namespace: AWS/Sagemaker/ModelBuildingPipeline statistic:
["Average"] name: - ExecutionDuration - StepDuration
{{#if credential_profile_name}}
  credential_profile_name:
  {{credential_profile_name}}
{{/if}}
{{#if shared_credential_file}}
  shared_credential_file:
  {{shared_credential_file}}
{{/if}}
{{#if default_region}}
  default_region:
  {{default_region}}
{{/if}}
{{#if access_key_id}}
  access_key_id:
  {{access_key_id}}
{{/if}}
{{#if secret_access_key}}
  secret_access_key:
  {{secret_access_key}}
{{/if}}
{{#if session_token}}
  session_token:
  {{session_token}}
{{/if}}
{{#if role_arn}}
  role_arn:
  {{role_arn}}
{{/if}}
{{#if supports_identity_federation}}
  use_cloud_connectors: true
{{/if}}
{{#if proxy_url}}
  proxy_url:
  {{proxy_url}}
{{/if}}
{{#if tags.length}}
  tags:
  {{#each tags as |tag|}}
    -
    {{tag}}
  {{/each}}
  {{#if preserve_original_event}}
    - preserve_original_event
  {{/if}}
{{else}}
  {{#if preserve_original_event}}
    tags: - preserve_original_event
  {{/if}}
{{/if}}
{{#contains "forwarded" tags}}
  publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
  processors:
  {{processors}}
{{/if}}